# ─────────────────────────────────────────────────────────────
#  OsintX — конфигурация. Скопируй в .env и заполни что есть.
#  Всё опционально: без ключей работает ~200 источников.
# ─────────────────────────────────────────────────────────────

# --- Общее ---
OSINTX_DATA_DIR=.osintx-data          # кэш, история, своя база (SQLite)
OSINTX_TIMEOUT=15                     # таймаут одного запроса, сек
OSINTX_CONCURRENCY=40                 # одновременных запросов
OSINTX_PROXY=                         # http://user:pass@host:port (или socks5://)
OSINTX_USER_AGENT=                    # свой User-Agent

# --- Web UI ---
OSINTX_HOST=0.0.0.0
OSINTX_PORT=8000

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=                   # токен от @BotFather
TELEGRAM_ALLOWED_IDS=                 # 123456,789012 — список user id (пусто = доступ всем)
WEB_PUBLIC_URL=                       # https://ваш-домен — для кнопки Mini App в боте

# --- Telegram MTProto (глубокий модуль: ID, DC, поиск сообщений) ---
TG_API_ID=                            # https://my.telegram.org → API development tools
TG_API_HASH=
TG_SESSION=osintx                     # имя файла сессии

# --- Ключи провайдеров (все опциональные, расширяют покрытие) ---
HIBP_API_KEY=                         # haveibeenpwned.com/API/Key
LEAKCHECK_API_KEY=                    # leakcheck.io
DEHASHED_API_KEY=                     # dehashed.com
DEHASHED_EMAIL=
INTELX_API_KEY=                       # intelx.io
HUNTER_API_KEY=                       # hunter.io — поиск email по домену
SHODAN_API_KEY=                       # shodan.io (плюс к InternetDB, который бесплатный)
VIRUSTOTAL_API_KEY=                   # virustotal.com
IPINFO_TOKEN=                         # ipinfo.io (иначе ip-api.com без ключа)
NUMVERIFY_API_KEY=                    # numverify.com — оператор/тип по номеру
VERIPHONE_API_KEY=                    # veriphone.io
SERPAPI_KEY=                          # serpapi.com — реальная выдача Google
SEARXNG_URL=                          # https://searx.example.com — свой SearXNG
